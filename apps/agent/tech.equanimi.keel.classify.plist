<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  keel capture classifier.

  Both database files are watched because Things is WAL-mode: writes land in
  -wal and reach main.sqlite at checkpoint.

  There is deliberately no KeepAlive — this must not be a resident process.
  Each fire classifies everything new and exits; the model is unloaded before
  exit, so idle draw is zero.

  ThingsData-851R6 is this machine's directory name. It varies per install —
  findThingsDb() discovers it at runtime, but launchd needs a literal path, so
  substitute the value from that function when installing elsewhere.

  Requires `ollama serve` to be running. It is hand-started on this machine; if
  it is down the run exits early and the captures wait for the next fire.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>tech.equanimi.keel.classify</string>
  <!--
    Absolute path to node, NOT `/usr/bin/env node`. A launchd agent inherits a
    minimal PATH (/usr/bin:/bin:/usr/sbin:/sbin), so `env node` exits 127 and
    launchd surfaces that only as LastExitStatus 32512 — the job otherwise
    looks perfectly healthy, which is how this survived review and was caught
    only by loading it for real.

    This is the pnpm shim rather than the versioned binary underneath it
    (.../nodejs/24.18.0/bin/node), so a Node upgrade does not silently break
    the agent.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/rafa/Library/pnpm/node</string>
    <string>/Users/rafa/Developer/equanimitech/keel/apps/agent/keel-classify.mjs</string>
  </array>
  <key>WatchPaths</key>
  <array>
    <string>/Users/rafa/Library/Group Containers/JLMPQHK86H.com.culturedcode.ThingsMac/ThingsData-851R6/Things Database.thingsdatabase/main.sqlite</string>
    <string>/Users/rafa/Library/Group Containers/JLMPQHK86H.com.culturedcode.ThingsMac/ThingsData-851R6/Things Database.thingsdatabase/main.sqlite-wal</string>
  </array>
  <key>StandardErrorPath</key><string>/Users/rafa/.keel/log/classify.err</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
