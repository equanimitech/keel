{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "keel",
  "version": "0.1.0",
  "identifier": "tech.equanimi.keel.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "tooltip": "keel"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
