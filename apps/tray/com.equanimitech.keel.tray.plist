<?xml version="1.0" encoding="UTF-8"?>
<!-- keel tray — keep the desktop activity writer up.

     WHY THIS EXISTS. Over 2026-06-12..08-07 the desktop writer was dark for
     1096h of a 1342h span. 670h of that (55 separate gaps) was time the Mac
     was demonstrably in use — the browser and agent surfaces were logging
     while the tray was not. The worst single gap ran 90.3h, during which the
     browser wrote 916 events and the agent 790.

     Diagnosis: zero crash reports in ~/Library/Logs/DiagnosticReports, and
     `writer_paused` was never emitted. The tray was not crashing and was not
     being paused — it simply was not relaunched after a restart, and
     `writer_started` fired only 24 times in 56 days. There was no autostart
     mechanism of any kind.

     Consequence for the read side: every hour-of-day derivation was fitted to
     when the WRITER happened to be up, not when attention happened. A daily
     rhythm is not identifiable from a sample like that (see
     ~/.keel/analysis/2026-08-07-attention-axes-findings.md, section 3).

     Install:  cp apps/tray/com.equanimitech.keel.tray.plist ~/Library/LaunchAgents/
               launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.equanimitech.keel.tray.plist
     Uninstall: launchctl bootout gui/$(id -u)/com.equanimitech.keel.tray
     Status:    launchctl print gui/$(id -u)/com.equanimitech.keel.tray | head -20
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.equanimitech.keel.tray</string>

    <!-- The bundle's inner binary, not `open -a`: launchd must own the
         process to supervise it. Safe here because the app is LSUIElement
         (menubar-only, no dock icon, no windows) so it needs nothing from
         LaunchServices. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/keel.app/Contents/MacOS/keel-tray</string>
    </array>

    <!-- The actual fix: the writer was dying at reboot and staying dead. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Unconditional restart is deliberate, and is NOT overriding intent.
         The tray's own menubar pause is the intended off-switch — it keeps
         the process alive and records `writer_paused`, so a deliberate stop
         stays in the log as data. Quitting the app is not how observation is
         turned off; it is how observation is silently lost, which is the
         failure this file exists to end.

         An unconditional KeepAlive CAN loop, and did on first install — see
         the note below. ThrottleInterval bounds it to one spawn per 30s,
         which is slow enough to notice and cheap enough to ignore. -->
    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- FIRST-INSTALL GOTCHA, learned the hard way on 2026-08-07.
         Bootstrapping while a hand-launched keel.app is already running gives
         a silent restart loop: the app's single-instance guard makes launchd's
         copy exit **0**, KeepAlive respawns it, repeat every ThrottleInterval.
         Crash reports never show it — a clean exit is not a crash — so the
         only tell is `runs` climbing in `launchctl print`.

             launchctl print gui/$(id -u)/com.equanimitech.keel.tray \
               | grep -E 'runs|job state'

         `job state = running` and a static `runs` is healthy. `job state =
         exited` with `runs` incrementing means a second instance owns the
         slot; quit it and launchd's copy takes over within 30s. -->

    <key>StandardErrorPath</key>
    <string>/tmp/keel-tray.log</string>
    <key>StandardOutPath</key>
    <string>/tmp/keel-tray.log</string>
</dict>
</plist>
