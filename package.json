{
  "name": "keel",
  "description": "keel — attentive technology platform (observe-first). pnpm monorepo of capability × surface apps over one shared domain.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "dev:browser": "pnpm --filter @keel/browser dev",
    "dev:desktop": "pnpm --filter @keel/desktop dev",
    "dev:tray": "pnpm --filter @keel/tray dev",
    "build:browser": "pnpm --filter @keel/browser build",
    "deploy:browser": "pnpm --filter @keel/browser run deploy",
    "build:desktop": "pnpm --filter @keel/desktop build",
    "build:tray": "pnpm --filter @keel/tray bundle",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-versions.js",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8"
  }
}
